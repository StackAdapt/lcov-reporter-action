{
	"name": "lcov-reporter-action",
	"version": "1.0.0",
	"description": "Comments a pull request with the lcov code coverage",
	"license": "MIT",
	"author": "Romeo Van Snick",
	"repository": "https://github.com/StackAdapt/lcov-reporter-action",
	"keywords": [
		"actions",
		"pull-request",
		"comment",
		"message"
	],
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.js --sourcemap",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write 'src/**/*.ts'",
		"lint": "tsc --noEmit && vitest run",
		"smoke": "node --test src/__smoke__/*.test.mjs"
	},
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"lcov-parse": "^1.0.0"
	},
	"devDependencies": {
		"@types/lcov-parse": "^1.0.2",
		"@types/node": "^24.0.0",
		"esbuild": "^0.25.0",
		"prettier": "^3.5.0",
		"typescript": "^5.8.0",
		"vitest": "^3.1.0"
	},
	"prettier": {
		"semi": false,
		"useTabs": true,
		"trailingComma": "all"
	}
}
